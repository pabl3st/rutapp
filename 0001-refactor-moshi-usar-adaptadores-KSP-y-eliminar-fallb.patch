diff --git a/app/src/main/kotlin/com/pabl3st/rutapp/di/NetworkModule.kt b/app/src/main/kotlin/com/pabl3st/rutapp/di/NetworkModule.kt
index 92af7c6..f742a7e 100644
--- a/app/src/main/kotlin/com/pabl3st/rutapp/di/NetworkModule.kt
+++ b/app/src/main/kotlin/com/pabl3st/rutapp/di/NetworkModule.kt
@@ -2,7 +2,6 @@ package com.pabl3st.rutapp.di
 
 import com.pabl3st.rutapp.data.network.RutasApiService
 import com.squareup.moshi.Moshi
-import com.squareup.moshi.kotlin.reflect.KotlinJsonAdapterFactory
