@@ -31,9 +30,9 @@ object NetworkModule {
 
     @Provides
     @Singleton
-    fun provideMoshi(): Moshi = Moshi.Builder()
-        .addLast(KotlinJsonAdapterFactory())
-        .build()
+    // Todos los DTOs usan @JsonClass(generateAdapter = true) -> adaptadores KSP.
